{
  "info": {
    "_postman_id": "6f3c1b8e-9d2a-4a5c-8b7e-5d4c3b2a1f0e",
    "name": "Amanda Coffee Café API",
    "description": "REST API for the Amanda Coffee Cafe Management System.\n\nBase URL: http://localhost:5000/api\n\nAuth: Most endpoints require a Bearer token returned by `POST /auth/login`. Use the collection variable `token` (set by the Login request's test script).\n\nDemo accounts (password for all: `12345678`):\n- admin@amanda.com (admin)\n- manager@amanda.com (manager)\n- cashier@amanda.com (cashier)\n- waiter@amanda.com (waiter)\n- kitchen@amanda.com (kitchen)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    pm.test('Token stored', () => pm.expect(json.data.token).to.not.be.empty);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@amanda.com\",\n  \"password\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (ME)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
